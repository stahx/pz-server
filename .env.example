# Required. Admin account password, created on first boot.
ADMIN_PASSWORD=

# Server name. Also the name of the config files under Zomboid/Server/.
SERVER_NAME=pzserver

# JVM heap for the server. 3g comfortably handles ~6 players.
MEMORY=3g

# Hard RAM ceiling for the container. Keep it above MEMORY.
MEM_LIMIT=5g

# Host UDP ports.
GAME_PORT=16261
PLAYER_PORT=16262

# Set to true to skip the Steam update on start (e.g. during a Steam outage).
SKIP_UPDATE=false

# Seconds to wait for the world to save when stopping.
STOP_TIMEOUT=90

TZ=UTC

# --- Server .ini settings, applied on every start ---
# Empty value: the key is left alone, so manual edits to the .ini survive restarts.
# Non-empty value: the environment wins and overwrites manual edits.

# false enables whitelist mode (only accounts created with `adduser` may join)
PZ_OPEN=
# list the server publicly
PZ_PUBLIC=
PZ_PUBLIC_NAME=
# server-wide password, separate from per-account passwords used in whitelist mode
PZ_SERVER_PASSWORD=
PZ_MAX_PLAYERS=
PZ_PAUSE_EMPTY=

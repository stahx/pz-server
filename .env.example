# The prefix says where a value goes:
#   PZ_      one key in Zomboid/Server/<SERVER_NAME>.ini (PZ_MAX_PLAYERS -> MaxPlayers)
#   SERVER_  the game process: name, admin password, memory, SteamID whitelist, timeouts
#   STEAM_   installing and updating the game files with SteamCMD
#   UPDATE_  the watcher that restarts a running server for game and mod updates
#   HOST_    the host side of compose: published ports, RCON bind address, memory cap

# Optional. Password of the bootstrap `admin` account the game insists on.
# Leave empty and a random one is generated (not logged). Grant admin to your own
# account instead: setaccesslevel "<name>" admin. Visible in `ps` inside the container.
SERVER_ADMIN_PASSWORD=

# Server name. Also the name of the config files under Zomboid/Server/.
SERVER_NAME=pzserver

# JVM heap. Around 3g is a sensible floor for ~6 players; usage grows with the explored map.
SERVER_MEMORY=3g

# Hard RAM ceiling for the container. Keep it above SERVER_MEMORY.
HOST_MEM_LIMIT=5g

# Host UDP ports.
HOST_GAME_PORT=16261
HOST_PLAYER_PORT=16262

# --- Whitelist by SteamID64 (17 digits), separated by spaces (; and , also work) ---
# Additive: every start inserts each entry into the game's allowedsteamid table before launch, nothing is ever removed.
# Combine with PZ_OPEN=false so only these Steam accounts can join.
# Remove an id from the console or over RCON: removesteamid "<steamid64>"
SERVER_WHITELIST_STEAMID=

# --- RCON (TCP) ---
# Empty password keeps RCON disabled. The port is published on HOST_RCON_BIND only.
PZ_RCON_PORT=27015
PZ_RCON_PASSWORD=
# 127.0.0.1 = reachable only from the host (use an SSH tunnel). 0.0.0.0 exposes it publicly; avoid.
HOST_RCON_BIND=127.0.0.1

# --- Server .ini settings, applied on every start ---
# Empty value: the key is left alone, so manual edits to the .ini survive restarts.
# Non-empty value: the environment wins and overwrites manual edits.
# A single dash (-): the key is written empty, which is how you clear one.
# PZ_MODS, PZ_WORKSHOP_ITEMS and PZ_MAP are the exception: they always follow the environment,
# so clearing them is enough to remove the mods (an empty PZ_MAP means the base map).

# false = closed server: only the admin, whitelisted SteamIDs and existing accounts can join
PZ_OPEN=
# list the server publicly
PZ_PUBLIC=
PZ_PUBLIC_NAME=
# shown in the public server browser
PZ_PUBLIC_DESCRIPTION=
# shown to players on join; <LINE> starts a new line
PZ_WELCOME_MESSAGE=
# true/false: players can hurt each other
PZ_PVP=
# server-wide password, separate from per-account passwords
PZ_SERVER_PASSWORD=
PZ_MAX_PLAYERS=
PZ_PAUSE_EMPTY=
# Steam Workshop mods, declarative: the server runs exactly what is listed here and nothing else.
# Clear these and the mods are gone, files included. WorkshopItems = ids from the Workshop page URL,
# Mods = ids from each mod's mod.info, both ;-separated. Mods order = load order. Applied on restart.
PZ_WORKSHOP_ITEMS=
PZ_MODS=
# Map folders, ;-separated, base map last: a map mod's folder name, then Muldraugh, KY.
# Empty = the base map only.
PZ_MAP=
# Backups the game takes itself, see "Backups" in the README.
# The next three ship with defaults because the game's own (0, 0, true) do not suit a
# server in a container; 0 turns the period backup or the periodic save off.
# Minutes between world backups (backups/period/).
PZ_BACKUPS_PERIOD=60
# Minutes between full world saves; bounds what a crash or an OOM kill can lose.
PZ_SAVE_WORLD_EVERY_MINUTES=15
# UPnP asks the local router to forward the game ports. A container never reaches one,
# and the search stalls every start for several seconds, so it is off by default.
PZ_UPNP=false
# Zips kept in each of backups/startup, backups/version and backups/period. Empty keeps the
# game's default of 5; every zip is about the size of the world, so mind the disk.
PZ_BACKUPS_COUNT=

# --- Updates ---
# Steam branch to install and track. 'public' is the current release; the game also
# publishes others (for example a beta branch, or one pinned to an older build).
# List them with: steamcmd +login anonymous +app_info_print 380870 +quit
STEAM_BRANCH=public
# true = never update: skips the Steam update on start and turns the update watcher off,
# which freezes the server on the build it already has. Also useful during a Steam outage.
STEAM_SKIP_UPDATE=false
# true = steamcmd re-verifies every file on each start (slow, ~7 GB hashed). Use to repair a broken install.
STEAM_VALIDATE=false
# Emergency only: deletes the game install and downloads it again from scratch (~7 GB).
# Steam occasionally wedges an install so that neither an update nor a validate fixes it,
# and clients then see missing files or checksum kicks. Set it, start once, set it back to false.
STEAM_REINSTALL=false
# steamcmd usually fails its first run in a fresh container, so the update is retried.
STEAM_UPDATE_ATTEMPTS=3
# Seconds between update checks while the server runs (3600 = hourly); 0 disables them.
# Checks the game build on Steam and, with PZ_WORKSHOP_ITEMS set, the Workshop mods.
# On an update the server restarts as soon as nobody is online.
UPDATE_CHECK_INTERVAL=3600
# With players online the restart waits for them to log out, nagging in chat every 5 minutes,
# and is forced after this many seconds with a 30-second countdown; 0 restarts immediately.
UPDATE_FORCE_SECONDS=1800

# --- Timeouts (seconds) ---
# How long to wait for the world to save when stopping.
SERVER_STOP_TIMEOUT=90
# How long to wait for the server to report SERVER STARTED before skipping post-start steps.
SERVER_START_TIMEOUT=300

TZ=UTC

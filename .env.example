# Optional. Password of the bootstrap `admin` account the game insists on.
# Leave empty and a random one is generated (not logged). Grant admin to your own
# account instead: setaccesslevel "<name>" admin. Visible in `ps` inside the container.
ADMIN_PASSWORD=

# Server name. Also the name of the config files under Zomboid/Server/.
SERVER_NAME=pzserver

# JVM heap. Around 3g is a sensible floor for ~6 players; usage grows with the explored map.
MEMORY=3g

# Hard RAM ceiling for the container. Keep it above MEMORY.
MEM_LIMIT=5g

# Host UDP ports.
GAME_PORT=16261
PLAYER_PORT=16262

# --- Whitelist by SteamID64 (17 digits), separated by ; ---
# Additive: every start sends `addsteamid` for each entry, nothing is ever removed.
# Combine with PZ_OPEN=false so only these Steam accounts can join.
# Remove an id from the console or over RCON: removesteamid "<steamid64>"
WHITELIST=

# --- RCON (TCP) ---
# Empty password keeps RCON disabled. The port is published on RCON_BIND only.
PZ_RCON_PORT=27015
PZ_RCON_PASSWORD=
# 127.0.0.1 = reachable only from the host (use an SSH tunnel). 0.0.0.0 exposes it publicly; avoid.
RCON_BIND=127.0.0.1

# --- Server .ini settings, applied on every start ---
# Empty value: the key is left alone, so manual edits to the .ini survive restarts.
# Non-empty value: the environment wins and overwrites manual edits.

# false = closed server: only the admin, whitelisted SteamIDs and existing accounts can join
PZ_OPEN=
# list the server publicly
PZ_PUBLIC=
PZ_PUBLIC_NAME=
# server-wide password, separate from per-account passwords
PZ_SERVER_PASSWORD=
PZ_MAX_PLAYERS=
PZ_PAUSE_EMPTY=

# --- Updates ---
# true = skip the Steam update on start (e.g. during a Steam outage).
SKIP_UPDATE=false
# true = steamcmd re-verifies every file on each start (slow, ~7 GB hashed). Use to repair a broken install.
STEAM_VALIDATE=false
# steamcmd usually fails its first run in a fresh container, so the update is retried.
UPDATE_ATTEMPTS=3

# --- Timeouts (seconds) ---
# How long to wait for the world to save when stopping.
STOP_TIMEOUT=90
# How long to wait for the server to report SERVER STARTED before skipping post-start steps.
STARTUP_TIMEOUT=300

TZ=UTC
